{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowAppToReadAssets",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:ListBucket"
            ],
            "Resource": [
                "arn:aws:s3:::devops-platform-assets",
                "arn:aws:s3:::devops-platform-assets/*"
            ]
        }
    ]
}